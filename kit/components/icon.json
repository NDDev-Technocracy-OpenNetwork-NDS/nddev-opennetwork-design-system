      "description": ""
    },
    {
      "id": "down",
      "description": ""
    },
    {
      "id": "external",
      "description": "Out of the site: the arrow up and forward, mirrored right to left."
    }
  ],
  "states": ["default"],
  "cues": {},
  "keyboard": [],
