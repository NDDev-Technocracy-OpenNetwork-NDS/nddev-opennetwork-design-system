{
  "name": "Notice",
  "category": "feedback",
  "status": "implemented",
  "summary": "A message about the page or a result: an icon, a word and a sentence on a status tint.",
  "pattern": {
    "apg": "alert",
    "html": "<div role=\"status\"> or role=\"alert\" when urgent"
  },
  "tokens": "notice",
  "textStyle": "body",
  "anatomy": [
    {
      "part": "icon",
      "required": true,
      "description": "Status glyph in the status text colour."
    },
    {
      "part": "label",
      "required": true,
      "description": "The status word (\"Error\", \"Sent\")."
    },
    {
      "part": "message",
      "required": true,
      "description": "What happened and what to do."
    },
    {
      "part": "action",
      "required": false,
      "description": "A secondary button; its text turns neutral on the tint."
    }
  ],
  "variants": [
    {
      "id": "info",
      "description": ""
    },
    {
      "id": "success",
      "description": ""
    },
    {
      "id": "warning",
      "description": ""
    },
    {
      "id": "danger",
      "description": ""
    }
  ],
  "states": ["default"],
  "cues": {
    "default": "Icon and word, not colour alone; a thick leading edge."
  },
  "keyboard": [],
  "a11y": {
    "role": "status (polite) or alert (assertive)",
    "name": "",
    "notes": [
      "Only messages that need immediate attention are alerts.",
      "A saved inquiry, a sent mail and a delivered mail are different states and say so."
    ],
    "wcag": ["1.3.1", "1.4.1", "1.4.3", "4.1.3"]
  },
  "platforms": {
    "web": ".nd-notice[data-status]",
    "ios": "a labelled row with an SF Symbol",
    "android": "Card with an icon (or Snackbar for transient)",
    "flutter": "MaterialBanner"
  },
  "web": {
    "class": "nd-notice",
    "modifiers": []
  },
  "contrast": [
    {
      "fg": "notice.text",
      "bg": "notice.info.fill",
      "min": 4.5
    },
    {
      "fg": "notice.text",
      "bg": "notice.success.fill",
      "min": 4.5
    },
    {
      "fg": "notice.text",
      "bg": "notice.warning.fill",
      "min": 4.5
    },
    {
      "fg": "notice.text",
      "bg": "notice.danger.fill",
      "min": 4.5
    },
    {
      "fg": "notice.info.icon",
      "bg": "notice.info.fill",
      "min": 3
    },
    {
      "fg": "notice.success.icon",
      "bg": "notice.success.fill",
      "min": 3
    },
    {
      "fg": "notice.warning.icon",
      "bg": "notice.warning.fill",
      "min": 3
    },
    {
      "fg": "notice.danger.icon",
      "bg": "notice.danger.fill",
      "min": 3
    }
  ]
}
