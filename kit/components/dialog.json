{
  "name": "Dialog",
  "category": "container",
  "status": "implemented",
  "summary": "A modal window for a short task or a decision; a sheet on phones.",
  "pattern": {
    "apg": "dialog-modal",
    "html": "<dialog> opened with showModal()"
  },
  "tokens": "dialog",
  "textStyle": "body",
  "anatomy": [
    {
      "part": "scrim",
      "required": true,
      "description": "Dims the page; inert behind."
    },
    {
      "part": "surface",
      "required": true,
      "description": "Overlay surface, elevation 3."
    },
    {
      "part": "title",
      "required": true,
      "description": "h2 labelling the dialog."
    },
    {
      "part": "body",
      "required": true,
      "description": "Content."
    },
    {
      "part": "actions",
      "required": true,
      "description": "Primary and secondary buttons."
    },
    {
      "part": "close",
      "required": false,
      "description": "A labelled close button."
    }
  ],
  "variants": [
    {
      "id": "dialog",
      "description": "Centred."
    },
    {
      "id": "alert",
      "description": "role=alertdialog for a decision with consequences."
    },
    {
      "id": "sheet",
      "description": "From the bottom on a phone; centred on desktop."
    }
  ],
  "states": ["closed", "open"],
  "cues": {},
  "keyboard": [
    {
      "keys": "Escape",
      "action": "Closes."
    },
    {
      "keys": "Tab, Shift+Tab",
      "action": "Stay inside the dialog."
    },
    {
      "keys": "Enter",
      "action": "Activates the focused button."
    }
  ],
  "a11y": {
    "role": "dialog / alertdialog",
    "name": "aria-labelledby its title.",
    "notes": [
      "Focus moves to the first useful control, and back to the opener on close.",
      "The page behind is inert."
    ],
    "wcag": ["1.3.1", "2.1.2", "2.4.3", "2.4.7", "2.4.13", "2.4.11", "4.1.2"]
  },
  "platforms": {
    "web": "dialog.nd-dialog",
    "ios": ".sheet / .alert / .confirmationDialog",
    "android": "AlertDialog / ModalBottomSheet",
    "flutter": "showDialog / showModalBottomSheet"
  },
  "web": {
    "class": "nd-dialog",
    "modifiers": []
  },
  "contrast": [
    {
      "fg": "dialog.text",
      "bg": "dialog.fill",
      "min": 4.5
    }
  ]
}
