{
  "name": "Navigation",
  "category": "navigation",
  "status": "implemented",
  "summary": "The destinations of a product: a list or bar where the current one is marked.",
  "pattern": {
    "apg": "landmarks",
    "html": "<nav> with links, aria-current=page"
  },
  "tokens": "navigation",
  "textStyle": "body",
  "anatomy": [
    {
      "part": "item",
      "required": true,
      "description": "Link with an optional icon."
    },
    {
      "part": "indicator",
      "required": true,
      "description": "Marks the current destination."
    }
  ],
  "variants": [
    {
      "id": "bar",
      "description": "Horizontal (header) or bottom bar (mobile)."
    },
    {
      "id": "rail",
      "description": "Vertical, desktop apps."
    },
    {
      "id": "dock",
      "description": "The site's touch dock: written tiles ."
    }
  ],
  "states": ["default", "hover", "focus-visible", "current"],
  "cues": {
    "current": "An indicator and aria-current; not colour alone."
  },
  "keyboard": [
    {
      "keys": "Tab",
      "action": "Through the destinations."
    }
  ],
  "a11y": {
    "role": "navigation",
    "name": "aria-label when a page has more than one navigation.",
    "notes": [],
    "wcag": ["1.3.1", "2.4.1", "2.4.3", "2.4.7", "2.4.13", "2.5.8"]
  },
  "platforms": {
    "web": "nav.nd-navigation with native links",
    "ios": "TabView / NavigationSplitView sidebar",
    "android": "NavigationBar / NavigationRail",
    "flutter": "NavigationBar / NavigationRail"
  },
  "contrast": [
    {
      "fg": "navigation.text",
      "bg": "surface.base",
      "min": 4.5
    },
    {
      "fg": "navigation.indicator",
      "bg": "surface.base",
      "min": 3
    }
  ],
  "web": {
    "class": "nd-navigation",
    "modifiers": ["rail", "dock"]
  }
}
