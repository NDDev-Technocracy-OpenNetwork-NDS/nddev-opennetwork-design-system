{
  "$extensions": {
    "ai.nddev": {
      "platform": {
        "unit": "pt",
        "note": "iOS and iPadOS: sizes at the default Dynamic Type setting; each scales with the text style it is relative to."
      }
    }
  },
  "text-size": {
    "$type": "dimension",
    "$description": "Dynamic Type default sizes; ai.nddev.dynamic-type names the SwiftUI text style each scales with.",
    "display": {
      "$value": {
        "value": 34,
        "unit": "px"
      },
      "$extensions": {
        "ai.nddev": {
          "dynamic-type": "largeTitle"
        }
      }
    },
    "h1": {
      "$value": {
        "value": 28,
        "unit": "px"
      },
      "$extensions": {
        "ai.nddev": {
          "dynamic-type": "title"
        }
      }
    },
    "h2": {
      "$value": {
        "value": 22,
        "unit": "px"
      },
      "$extensions": {
        "ai.nddev": {
          "dynamic-type": "title2"
        }
      }
    },
    "h3": {
      "$value": {
        "value": 20,
        "unit": "px"
      },
      "$extensions": {
        "ai.nddev": {
          "dynamic-type": "title3"
        }
      }
    },
    "h4": {
      "$value": {
        "value": 17,
        "unit": "px"
      },
      "$extensions": {
        "ai.nddev": {
          "dynamic-type": "headline"
        }
      }
    },
    "body-lg": {
      "$value": {
        "value": 17,
        "unit": "px"
      },
      "$extensions": {
        "ai.nddev": {
          "dynamic-type": "body"
        }
      }
    },
    "body": {
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$extensions": {
        "ai.nddev": {
          "dynamic-type": "callout"
        }
      }
    },
    "label": {
      "$value": {
        "value": 15,
        "unit": "px"
      },
      "$extensions": {
        "ai.nddev": {
          "dynamic-type": "subheadline"
        }
      }
    },
    "caption": {
      "$value": {
        "value": 12,
        "unit": "px"
      },
      "$extensions": {
        "ai.nddev": {
          "dynamic-type": "caption"
        }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": ["IBM Plex Sans", ".AppleSystemUIFont"]
    },
    "sans-ar": {
      "$value": ["IBM Plex Sans Arabic", ".AppleSystemUIFont"]
    },
    "sans-zh": {
      "$value": ["PingFang SC"]
    },
    "mono": {
      "$value": ["SF Mono", "Menlo"]
    },
    "$description": "Bundled families first (the Swift package carries the TTF files); Chinese is the system face (PingFang SC)."
  },
  "control": {
    "$type": "dimension",
    "$description": "Control and target sizes per density; the density modifier aliases size.* to one of them.",
    "$extensions": {
      "ai.nddev": {
        "private": true
      }
    },
    "comfortable": {
      "sm": {
        "$value": {
          "value": 36,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 44,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 50,
          "unit": "px"
        }
      },
      "field": {
        "$value": {
          "value": 44,
          "unit": "px"
        }
      },
      "target-min": {
        "$value": {
          "value": 44,
          "unit": "px"
        }
      }
    },
    "compact": {
      "sm": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 36,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 44,
          "unit": "px"
        }
      },
      "field": {
        "$value": {
          "value": 36,
          "unit": "px"
        }
      },
      "target-min": {
        "$value": {
          "value": 44,
          "unit": "px"
        }
      }
    }
  }
}
