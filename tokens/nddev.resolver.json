  "modifiers": {
    "direction": {
      "description": "The NDDev direction (brand) an interface belongs to.",
      "contexts": {
        "on": [
          {
            "$ref": "derived/direction/on.tokens.json"
          }
        ]
      },
      "default": "on"
    },
    "theme": {
      "description": "Colour theme.",
      "contexts": {
