{
  "$description": "The two colours words on a fill may take; a fill takes the one that needs the smaller move.",
  "on-fill": {
    "$type": "color",
    "light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0392, 0.0431, 0.0627],
        "hex": "#0a0b10"
      }
    }
  }
}
